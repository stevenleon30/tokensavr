# ---------------------------------------------------------------------------
# TokenSavr — example environment file
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real keys. Only the VITE_* values below
# are safe to expose (they ship in the browser bundle); everything else is
# server-only.
#
# On Lovable Cloud these are injected automatically — you only need this file
# for local development outside Lovable, or for self-hosting.
# ---------------------------------------------------------------------------

# --- Public / client-visible (safe to expose, bundled into the browser) -----
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Server-only mirrors (used during SSR and in server functions) ----------
# Same values as above; read via process.env, never sent to the browser.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
SUPABASE_PROJECT_ID="your-project-ref"

# --- Secrets (server-only — treat as passwords) -----------------------------
# Bypasses row-level security. Required only for privileged admin operations.
# Not retrievable on Lovable Cloud.
SUPABASE_SERVICE_ROLE_KEY=""

# Powers AI strategy generation (POST /api/generate-strategy).
LOVABLE_API_KEY=""

# Shared bearer token protecting POST /api/public/sync-model-pricing.
# Generate a strong random value, e.g. `openssl rand -hex 32`.
SYNC_PRICING_SECRET=""
